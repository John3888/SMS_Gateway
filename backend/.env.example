NODE_ENV=production
HOST=127.0.0.1
PORT=5008
APP_KEYS_FILE=./app-keys.json
DEVICE_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
MAX_PENDING=100
GLOBAL_SMS_PER_MINUTE=12
GLOBAL_SMS_BURST=10
MAX_COMPLETED=200
HISTORY_TTL_SECONDS=900

# Optional dashboard: configure all three. Use a unique password of 12 or more characters.
# DATABASE_URL=mysql://user:password@localhost:3306/sms_gateway
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# Local HTTP only. For HTTPS leave the secure default enabled.
# ADMIN_COOKIE_SECURE=false
